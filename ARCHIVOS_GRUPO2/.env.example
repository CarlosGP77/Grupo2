# ============================================
# .env.example para Grupo2
# ============================================
# Copiar a .env y ajustar valores para tu entorno

# Base de Datos
DB_USER=root
DB_PASSWORD=admin_123
DB_NAME=mourosub

# JPA/Hibernate
# validate: solo valida
# update: actualiza schema
# create-drop: crea nuevo cada startup
JPA_DDL_AUTO=create-drop

# Servidor
SERVER_PORT=8080

# Zona horaria
TZ=UTC

