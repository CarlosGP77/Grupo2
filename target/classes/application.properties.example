# URL de conexión JDBC a la base de datos.
spring.datasource.url=jdbc:mariadb://localhost:3306/your_database_name

# Usuario con el que la aplicación se conecta a MariaDB.
spring.datasource.username=your_username

# Contraseña del usuario
spring.datasource.password=your_password

# Comportamiento de Hibernate al arrancar respecto al esquema de BD:
#   - update  → sincroniza la tabla con la entidad sin borrar datos (desarrollo)
#   - validate → solo comprueba que coinciden, lanza error si no (preproducción)
#   - none     → no toca el esquema (producción)
spring.jpa.hibernate.ddl-auto=update

# Imprime en consola cada sentencia SQL que genera Hibernate.
# Muy útil para depurar consultas
spring.jpa.show-sql=true